# Claude AI
ANTHROPIC_API_KEY=your_claude_api_key_here

# Bot Configuration
BOT_NAME=bot
BOT_TRIGGERS=@bot,hey bot,bot,

# Google Calendar (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# Notion
NOTION_API_KEY=your_notion_integration_token

# Web Search (choose one)
# Brave Search API (recommended - free tier available)
BRAVE_SEARCH_API_KEY=your_brave_api_key

# OR Tavily AI Search
# TAVILY_API_KEY=your_tavily_api_key

# OR Google Custom Search
# GOOGLE_SEARCH_API_KEY=your_google_search_key
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Memory & State
CONVERSATION_MEMORY_LIMIT=20
STATE_TIMEOUT_MINUTES=5

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_CALENDAR=true
ENABLE_NOTION=true
ENABLE_RECEIPT_SCANNING=true

# Emoji Config (customize if you want different emojis)
EMOJI_RECEIVED=👀
EMOJI_THINKING=🤔
EMOJI_WORKING=⏳
EMOJI_QUESTION=❓
EMOJI_WARNING=⚠️
EMOJI_SUCCESS=✅
EMOJI_ERROR=❌
