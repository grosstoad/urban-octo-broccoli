{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "WhatsApp AI bot with Claude, Google Calendar, Notion, and web search",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "docker:build": "docker build -t whatsapp-ai-bot .",
    "docker:run": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down"
  },
  "keywords": ["whatsapp", "ai", "claude", "assistant", "calendar", "notion"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "whatsapp-web.js": "^1.25.0",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "dotenv": "^16.4.5",
    "better-sqlite3": "^11.7.0",
    "googleapis": "^144.0.0",
    "@notionhq/client": "^2.2.15",
    "date-fns": "^4.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
